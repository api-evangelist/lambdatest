          "name": "Fetch SmartUI build screenshots by project_id and build_id",
          "request": {
            "name": "Fetch SmartUI build screenshots by project_id and build_id",
            "description": {
              "content": "This API fetches all screenshots of a particular build with comparison details. **Note:** When both `build_id` and `build_name` are provided in the request, `buildId` will be given priority over `buildName`.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "smartui",
                "2.0",
                "build",
                "screenshots"
              ],
              "host": [
                "api",
                "lambdatest",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "project_name",
                  "value": "<string>",
                  "description": "(Required) The name of the particular project (project id can also be used)"
                },
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<string>",
                  "description": "Unique identifier of the project (project name can also be used)"
                },
                {
                  "disabled": false,
                  "key": "build_name",
                  "value": "<string>",
                  "description": "Build name can also be used instead of build Id (Optional)"
                },
                {
                  "disabled": false,
                  "key": "build_id",
                  "value": "<string>",
                  "description": "Fetches all the screenshots of a particular build"
                },
                {
                  "disabled": false,
                  "key": "baseline",
                  "value": "false",
                  "description": "Fetches the screenshots of the baseline build of the project"
                },
                {
                  "disabled": false,
                  "key": "screenshot_name",
                  "value": "<string>",
                  "description": "Fetches details of a specific screenshot"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
