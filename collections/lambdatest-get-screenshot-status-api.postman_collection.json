          "id": "a4803e70-ead6-4264-a148-5fea2fcf9f25",
          "name": "Fetch build status by buildId / buildName",
          "request": {
            "name": "Fetch build status by buildId / buildName",
            "description": {
              "content": "This API fetches the status of all screenshots which are uploaded to smartui using either build id or build name. **Note:** When both `buildId` and `buildName` are provided in the request, `buildId` will be given priority over `buildName`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "screenshot",
                "build",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "projectToken",
                  "value": "<string>",
                  "description": "(Required) To validate the project in which you want to map your uploaded screenshots"
                },
                {
                  "disabled": false,
                  "key": "buildId",
                  "value": "<string>",
                  "description": "You can pass the id of speicifc build if you need to map multiple screenshots of different tests to one build. (Optional)"
                },
                {
                  "disabled": false,
                  "key": "buildName",
                  "value": "<string>",
                  "description": "You can pass the name of specific build if you need to map multiple screenshots of different tests to one build. (Optional)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
