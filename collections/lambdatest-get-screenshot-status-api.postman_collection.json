              "item": [
                {
                  "name": "Fetch build status by buildId / buildName",
                  "id": "8517fb35-fa56-4524-ac80-12f39abcee30",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "basic",
                      "basic": [
                        {
                          "key": "username",
                          "value": "{{basicAuthUsername}}",
                          "type": "string"
                        },
                        {
                          "key": "password",
                          "value": "{{basicAuthPassword}}",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/screenshot/build/status?projectToken=<string>&buildId=<string>&buildName=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "screenshot",
                        "build",
                        "status"
                      ],
                      "query": [
                        {
                          "description": "(Required) To validate the project in which you want to map your uploaded screenshots",
                          "key": "projectToken",
                          "value": "<string>"
                        },
                        {
                          "description": "You can pass the id of speicifc build if you need to map multiple screenshots of different tests to one build. (Optional)",
                          "key": "buildId",
                          "value": "<string>"
                        },
                        {
                          "description": "You can pass the name of specific build if you need to map multiple screenshots of different tests to one build. (Optional)",
                          "key": "buildName",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "This API fetches the status of all screenshots which are uploaded to smartui using either build id or build name. **Note:** When both `buildId` and `buildName` are provided in the request, `buildId` will be given priority over `buildName`."
                  },
