      "name": "build",
      "item": [
        {
          "name": "status",
          "item": [
            {
              "name": "Fetch build status by buildId or buildName",
              "id": "1b5442a6-58a4-45c4-ad28-d70fdfce9302",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{basicAuthUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{basicAuthPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/build/status?projectToken=<string>&buildId=<string>&buildName=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "build",
                    "status"
                  ],
                  "query": [
                    {
                      "description": "(Required) Validate and map the project in which the build exists",
                      "key": "projectToken",
                      "value": "<string>"
                    },
                    {
                      "description": "Unique ID for the build. You can get it from the URL of build's tests page.",
                      "key": "buildId",
                      "value": "<string>"
                    },
                    {
                      "description": "Name of the build. (For storybook project, provide build ID)",
                      "key": "buildName",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "This API fetches the build status along with the count of different screenshot statuses. **Note:** When both `buildId` and `buildName` are provided in the request, `buildId` will be given priority over `buildName`."
              },
              "response": [
