          "request": {
            "name": "Fetch build status by buildId or buildName",
            "description": {
              "content": "This API fetches the build status along with the count of different screenshot statuses. **Note:** When both `buildId` and `buildName` are provided in the request, `buildId` will be given priority over `buildName`.\n",
              "type": "text/plain"
            },
